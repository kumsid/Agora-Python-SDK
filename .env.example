# Copy this file to `.env` in the repo root and fill in values.
# `.env` is gitignored — do not commit secrets.

# Required: Agora project App ID from https://console.agora.io/
AGORA_APP_ID=

# Optional: RTC token (required if your project enables App Certificate)
AGORA_TOKEN=

# Channel name (same for all simulated clients)
AGORA_CHANNEL=demo-loadtest

# How many separate OS processes to start (each = one RTC user). Start low.
CLIENT_COUNT=100

# Target upper bound for future scaling (informational log only)
TARGET_CLIENT_COUNT=10000

# First UID; client i uses UID_START + i (must be unique in the channel)
UID_START=100001

# Seconds to stay joined before leave + engine release
DURATION_SEC=300

# audience = LIVE_BROADCASTING subscriber (typical “viewer”; needs a host publishing in the channel).
# broadcaster = publishes A/V (use a small count; heavy on machine and channel).
CLIENT_ROLE=audience

# Milliseconds to wait between spawning each process (reduces connect spikes)
JOIN_STAGGER_MS=100

# Which client index (0 = first worker) logs onRtcStats ~every 2s (rxBytes, rxAudioBytes, rxVideoBytes, …).
# Set to none, off, or -1 to disable periodic stats (every worker still logs rx/tx on leave).
RTC_STATS_LOG_CLIENT_INDEX=0

# Directory (under repo root if relative) for one CSV per worker: client_{index}_uid_{uid}.csv
# Set to none, off, or 0 to disable CSV output.
RTC_STATS_CSV_DIR=rtc_stats_logs
